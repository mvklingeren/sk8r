{
	"name": "sk8r",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && esbuild src/lib/server/websocket.ts --bundle --platform=node --format=esm --packages=external --outfile=build/websocket.js",
		"preview": "vite preview",
		"start": "node server.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.20.5",
		"@vitest/browser-playwright": "^5.1.1",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@kubernetes/client-node": "^2.0.2",
		"@lucide/svelte": "^1.77.0",
		"@types/js-yaml": "^4.0.9",
		"@types/ws": "^8.18.2",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"chart.js": "^4.6.1",
		"chartjs-adapter-date-fns": "^3.0.0",
		"date-fns": "^4.4.0",
		"express": "^5.3.0",
		"js-yaml": "^5.5.0",
		"marked": "^18.2.1",
		"mermaid": "^12.3.0",
		"shiki": "^4.6.0",
		"ws": "^8.23.0"
	}
}
